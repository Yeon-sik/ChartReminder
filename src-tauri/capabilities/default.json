{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "sql:default",
    "sql:allow-execute",
    "dialog:allow-save",
    {
      "identifier": "http:default",
      "allow": [{ "url": "https://api.tiingo.com/*" }],
      "deny": []
    }
  ]
}
